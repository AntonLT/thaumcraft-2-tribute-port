{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "Azanor",
    "Alt"
  ],
  "license": "${license}",
  "icon": "assets/thaumcraft2tp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.thaumcraft.fabric.ThaumcraftFabric"
    ],
    "client": [
      "dev.thaumcraft.fabric.ThaumcraftFabricClient"
    ],
    "jei_mod_plugin": [
      "dev.thaumcraft.jei.ThaumcraftJeiPlugin"
    ]
  },
  "mixins": [
    "thaumcraft2tp.mixins.json"
  ],
  "accessWidener": "thaumcraft2tp.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}"
  }
}
